# Copy to server/.env and fill in. Never commit real values.

# Server
PORT=5002
NODE_ENV=development

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/sistem

# JWT signing secret — must be a long random value in production (server refuses the default)
JWT_SECRET=change-me

# CORS origin allowed to call the API (defaults to '*' when unset)
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the client app, used in password-reset links
CLIENT_URL=http://localhost:5173

# Coach that new trainees are assigned to on sign-up. Optional: when empty and exactly one
# coach exists, that coach is used; with no coach, trainees stay unassigned until one is
# promoted/seeded (promote:coach and seed:dev assign them).
DEFAULT_COACH_EMAIL=

# Email (Resend) — password reset (Backlog). Leave empty to skip sending.
RESEND_API_KEY=
EMAIL_FROM=Sistem <onboarding@resend.dev>

# Voyage embeddings for the knowledge (RAG) feature — used by seed:knowledge and Phase 12
VOYAGE_API_KEY=

# Cloudinary — onboarding media (media:upload script, Phase 2c) and private photos: Daily Pump
# (Phase 9, authenticated assets + 1-hour signed links), progress photos (Phase 10).
# Dashboard -> Settings -> API Keys. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
