# Base URL of the Sistem API (server). Must include /api.
VITE_API_URL=http://localhost:5002/api

# Web address of the coach dashboard (apps/dashboard). Optional: when empty, the app hides its
# "open the dashboard" links (login screen + coach Profile). Local dev: http://localhost:5174
VITE_COACH_DASHBOARD_URL=https://dashboard.example.com

# Optional, for static hosts that cannot answer inner addresses (GitHub Pages): "true" puts the
# routes after a "#" (…/#/login). Set by .github/workflows/deploy.yml — leave empty elsewhere.
VITE_HASH_ROUTER=
